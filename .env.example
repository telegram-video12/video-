# ===== הגדרות טלגרם (חובה) =====
# מקבלים ב-https://my.telegram.org -> API development tools
TG_API_ID=1234567
TG_API_HASH=abcdef0123456789abcdef0123456789

# ===== סיסמה לכניסה לאתר (חובה) =====
SITE_PASSWORD=change-me

# ===== TMDB - פוסטרים ותקצירים (רשות, מומלץ) =====
# מפתח חינמי מ-https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ===== הגדרות נוספות (רשות) =====
# כל כמה דקות לסרוק את הקבוצות אוטומטית (0 = רק ידנית)
SCAN_INTERVAL_MINUTES=30
# להתעלם מסרטונים קצרים מזה (שניות) - כדי לא להכניס טריילרים וקליפים
MIN_DURATION_SECONDS=180
# פורט האתר
PORT=8000
